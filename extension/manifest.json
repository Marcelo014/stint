{
  "manifest_version": 3,
  "name": "Stint",
  "version": "0.1.0",
  "description": "Save job applications to Stint from any job posting.",
  "_comment_key": "Pins the extension ID to mlhnojpajbdffkbacbkcmbmjkccgjlfb on every machine, so Clerk allowed_origins and authorizedParties stay valid. Public half of an RSA keypair; the private half is only needed to publish to the Web Store.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Stint"
  },
  "permissions": ["activeTab", "scripting", "cookies", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:3000/*",
    "https://*.clerk.accounts.dev/*"
  ]
}
